NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# GEMINI AI CONFIGURATION
# ============================================================
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyAgvqakr6CEU3QqWe3doGvWO-OKGAgB5sI
GEMINI_API_KEY=AIzaSyAgvqakr6CEU3QqWe3doGvWO-OKGAgB5sI

# ============================================================
# SITE CONFIGURATION
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aura Brew
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ============================================================
# ADMIN PANEL
# ============================================================
ADMIN_SECRET_KEY=generate-random-32-char-string
JWT_SECRET=generate-random-32-char-string
NEXT_PUBLIC_ADMIN_URL=/admin

# ============================================================
# COMMUNICATION
# ============================================================
RESEND_API_KEY=your-resend-api-key
NEXT_PUBLIC_WHATSAPP_NUMBER=+27701234567
NEXT_PUBLIC_SUPPORT_EMAIL=support@aurabrew.co.za

# ============================================================
# SOCIAL MEDIA
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/aurabrew
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/aurabrew
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@aurabrew
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@aurabrew

# ============================================================
# GOOGLE SERVICES
# ============================================================
GOOGLE_MAPS_API_KEY=your-google-maps-key
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================================
# FEATURE FLAGS
# ============================================================
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_BOOKINGS=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_LOYALTY=true
