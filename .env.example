# ============================================================
# SUPABASE CONFIGURATION
# Get from: https://supabase.com -> Project Settings -> API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# GEMINI AI CONFIGURATION
# API Key for AI Assistant and content generation
# ============================================================
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyAgvqakr6CEU3QqWe3doGvWO-OKGAgB5sI
GEMINI_API_KEY=AIzaSyAgvqakr6CEU3QqWe3doGvWO-OKGAgB5sI

# ============================================================
# SITE CONFIGURATION
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aura Brew
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ============================================================
# ADMIN PANEL
# ============================================================
ADMIN_SECRET_KEY=generate-a-random-32-character-string-here
JWT_SECRET=generate-another-random-32-character-string-here
NEXT_PUBLIC_ADMIN_URL=/admin
ADMIN_TOKEN_EXPIRY=86400

# ============================================================
# EMAIL & COMMUNICATION
# Get Resend API key from: https://resend.com
# ============================================================
RESEND_API_KEY=your-resend-api-key-here
NEXT_PUBLIC_WHATSAPP_NUMBER=+27701234567
NEXT_PUBLIC_SUPPORT_EMAIL=support@aurabrew.co.za
NEXT_PUBLIC_SUPPORT_PHONE=+27701234567

# ============================================================
# SOCIAL MEDIA URLS
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/aurabrew
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/aurabrew
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@aurabrew
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@aurabrew
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/aurabrew

# ============================================================
# GOOGLE SERVICES
# Get from Google Cloud Console
# ============================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# ============================================================
# IMAGE OPTIMIZATION (Cloudinary)
# Get from: https://cloudinary.com
# ============================================================
