CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================================
# PAYMENT PROCESSING (Optional - Stripe)
# Get from: https://stripe.com
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================================
# EMAIL TEMPLATES & MAILCHIMP (Optional)
# ============================================================
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_AUDIENCE_ID=your-audience-id

# ============================================================
# SECURITY
# ============================================================
NEXT_PUBLIC_ENCRYPTION_KEY=generate-random-32-char-encryption-key
CORS_ORIGIN=http://localhost:3000

# ============================================================
# FEATURE FLAGS
# ============================================================
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_BOOKINGS=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_LOYALTY=true
NEXT_PUBLIC_ENABLE_PWA=true
